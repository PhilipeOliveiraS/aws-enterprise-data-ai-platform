# TasKiro backend configuration template.
# Copy to .env and set a strong JWT_SECRET, e.g. `openssl rand -hex 48`.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3000
CORS_ORIGINS=http://localhost:5173

# SQLite database location.
# - Relative paths are resolved against the backend/ package root (NOT the
#   shell's current directory), so the file is always backend/taskiro.sqlite
#   regardless of where you launch `bun run dev` from.
# - In production (AWS), override with an absolute path on the EBS volume,
#   e.g. DB_PATH=/opt/taskiro/data/taskiro.sqlite
# WAL mode also creates sidecar files: taskiro.sqlite-wal and taskiro.sqlite-shm.
DB_PATH=./taskiro.sqlite
