{
  "mcpServers": {
    "sqlite-taskiro": {
      "command": "/home/philipe/.bun/bin/bunx",
      "args": [
        "-y",
        "mcp-server-sqlite-npx",
        "/home/philipe/Projetos/aws-enterprise-data-ai-platform/backend/taskiro.sqlite"
      ],
      "disabled": false,
      "autoApprove": [
        "read_query",
        "list_tables",
        "describe_table"
      ]
    },
    "fetch-docs": {
      "command": "/home/philipe/.local/bin/uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "disabled": false,
      "autoApprove": [
        "fetch"
      ]
    },
    "git-platform": {
      "command": "/home/philipe/.local/bin/uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "/home/philipe/Projetos/aws-enterprise-data-ai-platform"
      ],
      "disabled": false,
      "autoApprove": [
        "git_status",
        "git_diff_unstaged",
        "git_log"
      ]
    }
  }
}
