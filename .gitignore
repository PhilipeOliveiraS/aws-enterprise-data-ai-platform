# Terraform Local State & Variables (contêm outputs sensíveis)
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/

# Terraform plan files: a .tfplan is a zip that embeds a full tfstate snapshot
# (plus tfstate-prev and the whole config), so it must never be committed.
*.tfplan

# NOTE: .terraform.lock.hcl is deliberately NOT ignored. .kiro/steering/infra-standards.md
# mandates "AWS Provider v5.x with explicit lock files", and Terraform's own guidance is to
# commit the lock file so provider versions stay reproducible. Kept explicit to prevent a
# future broad pattern from silently excluding it.
!.terraform.lock.hcl

# Build artifacts (regenerated by `tsc -b` / `vite build`)
tsconfig.tsbuildinfo
